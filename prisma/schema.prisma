// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NULL means `name` is still the random-word-slugs placeholder and the LLM
  /// titler may overwrite it. Stamped by both the titler and a manual rename,
  /// so neither can clobber the other.
  titleGeneratedAt DateTime?

  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
  SUMMARY
}

model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([projectId, createdAt])
  @@index([projectId, type, createdAt])
}

/// User-uploaded images, stored as base64 directly in Postgres.
///
/// `data` is the base64 payload ONLY — no `data:<mime>;base64,` prefix; the two
/// consumers reassemble the data URL themselves. Never select `data` in a list
/// query: it is a TOASTed multi-megabyte value, and it must never appear in a
/// HTTP response (the chat message list polls while streaming). The only reads
/// are /api/attachments/[attachmentId] and the chat route's capped by-id fetch.
model Attachment {
  id String @id @default(uuid())
  mimeType String
  data String
  width Int
  height Int
  byteSize Int
  createdAt DateTime @default(now())

  messageId String
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Usage {
  key String @id
  points Int
  expire DateTime?
}
