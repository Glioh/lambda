{
	"name": "lambda",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24 <25"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors blue,green \"npm:dev:web\" \"npm:dev:api\"",
		"dev:web": "npm run dev --workspace @lambda/web",
		"dev:api": "npm run dev --workspace @lambda/api",
		"build": "npm run build --workspace @lambda/web",
		"start": "npm run start --workspace @lambda/web",
		"generate:openapi": "tsx scripts/generate-openapi.ts",
		"lint:openapi": "redocly lint lambda",
		"generate:api": "npm run generate:openapi && npm run lint:openapi && npm run generate --workspace @lambda/api-client && npx --no-install prettier apps/api/openapi packages/api-client/src/generated --write",
		"check:api-generated": "npm run generate:api && npm run typecheck --workspace @lambda/api && npm run test:api-client && npm run typecheck:api-client",
		"postinstall": "prisma generate",
		"lint": "npm run lint --workspace @lambda/web",
		"test": "npm run test --workspaces --if-present",
		"test:context": "npm run test:context --workspace @lambda/web",
		"test:chat": "npm run test:chat --workspace @lambda/web",
		"test:api-client": "npm run test --workspace @lambda/api-client",
		"test:attachments": "npm run test:attachments --workspace @lambda/web",
		"test:shell": "npm run test:shell --workspace @lambda/web",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"typecheck:api-client": "npm run typecheck --workspace @lambda/api-client",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@kubb/plugin-fetch": "5.0.0-beta.109",
		"@kubb/plugin-react-query": "5.0.0-beta.109",
		"@kubb/plugin-ts": "5.0.0-beta.109",
		"@redocly/cli": "^2.49.0",
		"concurrently": "^10.0.4",
		"dotenv": "^17.2.3",
		"kubb": "5.0.0-beta.110",
		"prettier": "3.9.6",
		"prettier-plugin-one-line-imports": "^1.0.3",
		"prisma": "^6.10.1"
	}
}
