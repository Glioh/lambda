{
	"tabWidth": 2,
	"printWidth": 100,
	"useTabs": true,
	"semi": true,
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"trailingComma": "all",
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"proseWrap": "preserve",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-one-line-imports", "@ianvs/prettier-plugin-sort-imports"],
	"importOrder": ["", "<TYPES>", "<THIRD_PARTY_MODULES>", "^[.]"],
	"importOrderTypeScriptVersion": "5.9.3"
}
