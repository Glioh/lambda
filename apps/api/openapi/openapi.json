{
	"openapi": "3.1.0",
	"info": {
		"title": "Lambda API",
		"version": "0.1.0"
	},
	"components": {
		"schemas": {
			"AttachmentInput": {
				"type": "object",
				"required": ["mimeType", "data", "width", "height"],
				"properties": {
					"mimeType": {
						"anyOf": [
							{
								"type": "string",
								"enum": ["image/png"]
							},
							{
								"type": "string",
								"enum": ["image/jpeg"]
							},
							{
								"type": "string",
								"enum": ["image/webp"]
							},
							{
								"type": "string",
								"enum": ["image/gif"]
							}
						]
					},
					"data": {
						"type": "string",
						"minLength": 1,
						"maxLength": 5592410
					},
					"width": {
						"type": "integer",
						"minimum": 1
					},
					"height": {
						"type": "integer",
						"minimum": 1
					}
				}
			},
			"AttachmentResponse": {
				"type": "object",
				"required": ["id", "mimeType", "width", "height"],
				"properties": {
					"id": {
						"type": "string"
					},
					"mimeType": {
						"type": "string"
					},
					"width": {
						"type": "integer"
					},
					"height": {
						"type": "integer"
					}
				}
			},
			"ErrorResponse": {
				"type": "object",
				"required": ["statusCode", "error", "message"],
				"properties": {
					"statusCode": {
						"type": "number"
					},
					"code": {
						"type": "string"
					},
					"error": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				}
			},
			"GenerateTitleResponse": {
				"anyOf": [
					{
						"type": "object",
						"required": ["id", "name"],
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							}
						}
					},
					{
						"type": "null"
					}
				]
			},
			"Message": {
				"type": "object",
				"required": ["id", "content", "role", "type", "createdAt", "updatedAt", "attachments"],
				"properties": {
					"id": {
						"type": "string"
					},
					"content": {
						"type": "string"
					},
					"role": {
						"anyOf": [
							{
								"type": "string",
								"enum": ["USER"]
							},
							{
								"type": "string",
								"enum": ["ASSISTANT"]
							}
						]
					},
					"type": {
						"anyOf": [
							{
								"type": "string",
								"enum": ["RESULT"]
							},
							{
								"type": "string",
								"enum": ["ERROR"]
							},
							{
								"type": "string",
								"enum": ["SUMMARY"]
							}
						]
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"attachments": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/AttachmentResponse"
						}
					}
				}
			},
			"Project": {
				"type": "object",
				"required": ["id", "name", "createdAt", "updatedAt", "titleGeneratedAt"],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"titleGeneratedAt": {
						"anyOf": [
							{
								"type": "string",
								"format": "date-time"
							},
							{
								"type": "null"
							}
						]
					}
				}
			},
			"ProjectIdResponse": {
				"type": "object",
				"required": ["id"],
				"properties": {
					"id": {
						"type": "string"
					}
				}
			},
			"ProjectListItem": {
				"type": "object",
				"required": ["id", "name", "createdAt", "updatedAt"],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"RenameProjectResponse": {
				"type": "object",
				"required": ["id", "name"],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					}
				}
			},
			"RollbackResponse": {
				"type": "object",
				"required": ["value", "hasAttachments"],
				"properties": {
					"value": {
						"type": "string"
					},
					"hasAttachments": {
						"type": "boolean"
					}
				}
			},
			"Usage": {
				"type": "object",
				"required": ["remainingPoints", "msBeforeNext"],
				"properties": {
					"remainingPoints": {
						"type": "number"
					},
					"msBeforeNext": {
						"type": "number"
					}
				}
			}
		}
	},
