{
	"name": "@lambda/web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"test": "npm run test:default && npm run test:react-server",
		"test:default": "node --experimental-test-module-mocks --import tsx --test \"test/api/**/*.test.ts\" \"test/lib/**/*.test.ts\" \"test/modules/**/*.test.ts\"",
		"test:context": "node --import tsx --test \"test/modules/context/**/*.test.ts\"",
		"test:chat": "node --experimental-test-module-mocks --import tsx --test \"test/modules/messages/**/*.test.ts\" \"test/modules/chats/server/completion/*.test.ts\" && npm run test:react-server",
		"test:react-server": "node --conditions react-server --import tsx --test \"test/react-server/**/*.test.ts\"",
		"test:attachments": "node --import tsx --test \"test/modules/attachments/**/*.test.ts\"",
		"test:shell": "node --import tsx --test \"test/modules/shell/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.0.8",
		"@clerk/themes": "^2.4.57",
		"@hookform/resolvers": "^5.2.2",
		"@lambda/api-client": "0.1.0",
		"@prisma/client": "^6.10.1",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-query": "5.101.4",
		"class-variance-authority": "^0.7.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"katex": "^0.18.1",
		"lucide-react": "^0.554.0",
		"next": "16.3.1",
		"next-themes": "^0.4.6",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-error-boundary": "^6.1.1",
		"react-hook-form": "^7.66.1",
		"react-markdown": "^10.1.0",
		"react-textarea-autosize": "^8.5.9",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.0.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "^4",
		"tsx": "^4.20.6",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5"
	},
	"overrides": {
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3"
	}
}
